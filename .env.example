# NovaCraft Orbai — Production & Netlify Environment Variables
# Copy this file to .env for local development or configure in Netlify Site Settings -> Environment Variables.

# Staff Admin Dashboard Passcode (Server-Side Only — Defaults to ORBAI-ADMIN-2026 in preview)
ADMIN_ACCESS_CODE=

# Optional Razorpay Online Payment Gateway Credentials (Server-Side Only)
# When omitted, the booking system automatically falls back to "Pay at Hospital" (PAYMENT_PENDING)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Server-Side Gemini API Key
GEMINI_API_KEY=
